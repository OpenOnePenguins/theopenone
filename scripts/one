#!/usr/bin/env python3
"""Local Open One bridge. Only Python's standard library is required."""
import argparse
import base64
import json
import os
from pathlib import Path
import sys
import time
import uuid


def home():
    return Path(os.environ.get("OPEN_ONE_HOME", str(Path.home() / "Library/Application Support/Open One")))


def prepare(root):
    for directory in (root, root / "events", root / "replies", root / "rejected"):
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)


def write_event(root, event):
    event = {"id": str(uuid.uuid4()), **event}
    # File names sort chronologically. A rename is the only publication point.
    destination = root / "events" / f"{time.time_ns():020d}-{event['id']}.json"
    temporary = destination.with_suffix(".tmp")
    fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    with os.fdopen(fd, "w") as output:
        json.dump(event, output)
        output.flush()
        os.fsync(output.fileno())
    temporary.replace(destination)
    return event["id"]


def response_path(root, request):
    encoded = base64.urlsafe_b64encode(request.encode()).decode().rstrip("=")
    return root / "replies" / f"{encoded}.json"


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("path", help="Print the local bridge directory")
    sub.add_parser("list", help="List known agents")
    for command in ("register", "working", "done", "offline", "message", "ask"):
        p = sub.add_parser(command)
        p.add_argument("--agent", required=True, help="Stable agent identifier")
        p.add_argument("--name")
        p.add_argument("--provider")
        p.add_argument("--directory", default=os.getcwd())
        if command == "ask":
            p.add_argument("--question", required=True)
            p.add_argument("--option", action="append", default=[])
            p.add_argument("--timeout", type=float, default=3600, help="Seconds to wait (default 3600)")
            p.add_argument("--json", action="store_true", help="Print structured reply")
        else:
            p.add_argument("--text")
    args = parser.parse_args(argv)
    root = home()
    prepare(root)
    if args.command == "path":
        print(root)
        return 0
    if args.command == "list":
        state = root / "state.json"
        print(json.dumps(json.loads(state.read_text()).get("agents", []) if state.exists() else [], indent=2))
        return 0
    event = {"agentID": args.agent, "kind": "question" if args.command == "ask" else args.command,
             "name": args.name or args.agent, "directory": args.directory}
    if args.provider:
        event["provider"] = args.provider
    if args.command != "ask":
        if args.text:
            event["text"] = args.text
        print(write_event(root, event))
        return 0
    if args.timeout <= 0:
        parser.error("--timeout must be greater than zero")
    request = str(uuid.uuid4())
    event.update(text=args.question, choices=args.option, requestID=request)
    write_event(root, event)
    target = response_path(root, request)
    deadline = time.monotonic() + args.timeout
    print(f"Waiting for an answer in Open One ({args.agent})…", file=sys.stderr)
    try:
        while time.monotonic() < deadline:
            if target.exists():
                response = json.loads(target.read_text())
                if response.get("requestID") != request or response.get("agentID") != args.agent:
                    raise ValueError("Reply identity does not match this question")
                print(json.dumps(response) if args.json else response["text"])
                target.unlink()
                return 0
            time.sleep(0.15)
    except KeyboardInterrupt:
        write_event(root, {"agentID": args.agent, "kind": "offline", "text": "Question cancelled in the calling terminal."})
        return 130
    write_event(root, {"agentID": args.agent, "kind": "offline", "text": "Question expired before an answer arrived."})
    print("Timed out waiting for an answer. No answer was assumed.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"one: {error}", file=sys.stderr)
        sys.exit(1)
